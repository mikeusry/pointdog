---
import { siteConfig } from '../data/siteConfig'
const year = new Date().getFullYear()
---

<footer class="bg-(--color-brand-primary-dark) text-white">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <img src="/logo-white.svg" alt="point.dog" width="160" height="48" class="h-10 w-auto" />
        <p class="mt-4 max-w-md text-sm text-white/80">
          {siteConfig.company.tagline}
        </p>
        <p class="mt-2 max-w-md text-sm text-white/60">
          We grow your business and operating efficiency — with marketing, websites, and the
          integrations that connect them.
        </p>
        <p class="mt-4 text-sm text-white/70">
          {siteConfig.company.address.full}
        </p>
      </div>

      <div class="md:col-span-3">
        <h6 class="text-xs font-semibold tracking-wider uppercase">Site</h6>
        <ul class="mt-3 space-y-1.5 text-sm text-white/80">
          <li><a href="/work" class="transition-colors hover:text-white">Work</a></li>
          <li><a href="/about" class="transition-colors hover:text-white">About</a></li>
          <li><a href="/contact" class="transition-colors hover:text-white">Contact</a></li>
          <li><a href="/privacy" class="transition-colors hover:text-white">Privacy</a></li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h6 class="text-xs font-semibold tracking-wider uppercase">Get In Touch</h6>
        <ul class="mt-3 space-y-1.5 text-sm text-white/80">
          <li>
            <a
              href={`mailto:${siteConfig.company.email}`}
              class="transition-colors hover:text-white"
            >
              {siteConfig.company.email}
            </a>
          </li>
          {
            siteConfig.social.linkedin && (
              <li>
                <a
                  href={siteConfig.social.linkedin}
                  rel="nofollow noopener"
                  target="_blank"
                  class="transition-colors hover:text-white"
                >
                  LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/60 md:flex-row md:justify-between"
    >
      <span>© {year} {siteConfig.company.longName}. All rights reserved.</span>
      <span>Athens, GA</span>
    </div>
  </div>
</footer>
