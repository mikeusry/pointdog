---
import { siteConfig } from '../data/siteConfig'
const year = new Date().getFullYear()
const { legal } = siteConfig
---

<footer class="bg-black text-white">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <img src="/logo-white.svg" alt="point.dog" width="160" height="48" class="h-10 w-auto" />
        <p class="mt-4 max-w-md text-sm text-white/80">
          {siteConfig.company.tagline}
        </p>
        <p class="mt-2 max-w-md text-sm text-white/60">
          We grow your business and operating efficiency — with marketing, websites, and the
          integrations that connect them.
        </p>
      </div>

      <div class="md:col-span-3">
        <h6 class="text-xs font-semibold tracking-wider uppercase">Site</h6>
        <ul class="mt-3 space-y-1.5 text-sm text-white/80">
          <li><a href="/work" class="transition-colors hover:text-white">Work</a></li>
          <li><a href="/integrations" class="transition-colors hover:text-white">Integrations</a></li>
          <li><a href="/guides" class="transition-colors hover:text-white">Guides</a></li>
          <li><a href="/about" class="transition-colors hover:text-white">About</a></li>
          <li><a href="/contact" class="transition-colors hover:text-white">Contact</a></li>
          <li><a href="/legal" class="transition-colors hover:text-white">Legal</a></li>
          <li><a href="/privacy" class="transition-colors hover:text-white">Privacy</a></li>
          {
            siteConfig.social.linkedin && (
              <li>
                <a
                  href={siteConfig.social.linkedin}
                  rel="nofollow noopener"
                  target="_blank"
                  class="transition-colors hover:text-white"
                >
                  LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <div
        class="md:col-span-3"
        itemscope
        itemtype="https://schema.org/Organization"
      >
        <h6 class="text-xs font-semibold tracking-wider uppercase">Company</h6>
        <meta itemprop="url" content="https://www.point.dog" />
        <p class="mt-3 text-sm font-semibold text-white" itemprop="legalName">
          {legal.name}
        </p>
        <p class="mt-1 text-sm text-white/70" itemprop="name">{legal.appleFormName}</p>
        <p class="mt-2 text-sm text-white/70">
          Georgia {legal.entityType.toLowerCase()}. Control number {legal.controlNumber}.
          Formed {legal.formed}.
        </p>
        <p class="mt-2 text-sm text-white/80">
          point.dog is owned and operated by this corporation.{' '}
          <a href="/legal" class="underline decoration-white/40 underline-offset-2 hover:text-white">
            Legal
          </a>
        </p>
        <address
          class="mt-3 text-sm not-italic text-white/80"
          itemprop="address"
          itemscope
          itemtype="https://schema.org/PostalAddress"
        >
          <span itemprop="streetAddress">{legal.address.street}</span><br />
          <span itemprop="addressLocality">{legal.address.city}</span>,{' '}
          <span itemprop="addressRegion">{legal.address.state}</span>{' '}
          <span itemprop="postalCode">{legal.address.postal}</span>
          <meta itemprop="addressCountry" content="US" />
        </address>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/60 md:flex-row md:justify-between"
    >
      <span>
        © {year} {legal.name}. All rights reserved. point.dog is a brand of the
        corporation, not a separate legal entity.
      </span>
      <span>{legal.address.city}, {legal.address.state}</span>
    </div>
  </div>
</footer>
