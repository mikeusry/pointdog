---
interface Props {
  client: string
  headline: string
  marketingPayoff: string
  stack: string[]
  href: string
  industry?: string
}

const { client, headline, marketingPayoff, stack, href, industry } = Astro.props
---

<a
  href={href}
  class="group block rounded-lg border border-(--color-brand-border) bg-white p-6 transition hover:border-(--color-brand-primary) hover:shadow-md"
>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="font-semibold tracking-wider text-(--color-brand-primary) uppercase">
      {client}
    </span>
    {
      industry && (
        <span class="text-(--color-brand-ink-muted)">· {industry}</span>
      )
    }
  </div>
  <h3 class="font-display mt-3 text-xl font-bold text-(--color-brand-ink) group-hover:text-(--color-brand-primary)">
    {headline}
  </h3>
  <p class="mt-3 text-sm text-(--color-brand-ink-muted)">
    {marketingPayoff}
  </p>
  {
    stack.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {stack.map((tech) => (
          <span class="inline-block rounded-full bg-(--color-brand-surface) px-2.5 py-0.5 text-[11px] font-medium text-(--color-brand-ink-muted)">
            {tech}
          </span>
        ))}
      </div>
    )
  }
  <span class="mt-5 inline-block text-sm font-semibold text-(--color-brand-primary)">
    Read the case study →
  </span>
</a>
