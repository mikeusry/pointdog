---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro'
import { siteConfig } from '../data/siteConfig'
---

<Layout
  title="Contact point.dog Digital"
  description="Tell us about your project. We don't take every job — but we'll be honest about whether we're a fit."
>
  <BreadcrumbSchema items={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }]} />

  <Hero
    eyebrow="Contact"
    title="Let's talk."
    subtitle="Tell us about your business and what's not working. We'll be straight with you about whether we're a fit."
    tone="primary"
  />

  <section class="px-6 py-16">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-3">
      <aside class="space-y-8 md:col-span-1">
        <div>
          <h3 class="font-display text-xl font-bold">Email</h3>
          <p class="mt-2 text-sm text-gray-700">
            <a
              href={`mailto:${siteConfig.company.email}`}
              class="text-(--color-brand-primary) hover:underline"
            >
              {siteConfig.company.email}
            </a>
          </p>
          <p class="mt-1 text-xs text-(--color-brand-ink-muted)">
            We typically reply within one business day.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-bold">Where we are</h3>
          <p class="mt-2 text-sm text-gray-700">
            {siteConfig.company.address.full}
          </p>
          <p class="mt-1 text-xs text-(--color-brand-ink-muted)">
            We work with clients across the United States.
          </p>
        </div>

        <div
          class="rounded-lg border border-(--color-brand-accent)/40 bg-(--color-brand-accent)/10 p-4"
        >
          <h4 class="text-sm font-bold text-(--color-brand-ink)">Honest expectations</h4>
          <p class="mt-2 text-xs leading-relaxed text-gray-700">
            We don't take every project. We're best for owner-operated businesses spending
            real money on ads with a backend that's holding the marketing back. We'll tell
            you straight if we're not a fit.
          </p>
        </div>
      </aside>

      <div class="md:col-span-2">
        <h3 class="font-display text-2xl font-bold">Tell us about your project</h3>
        <p class="mt-1 text-sm text-(--color-brand-ink-muted)">
          A few details so we can have a real first conversation.
        </p>

        <form id="contactForm" action="/api/contact" method="POST" class="mt-6 space-y-4">
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label for="name" class="text-sm font-semibold">Your Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="mt-1 w-full rounded-md border border-(--color-brand-border) px-3 py-2 text-sm focus:border-(--color-brand-primary) focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="text-sm font-semibold">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1 w-full rounded-md border border-(--color-brand-border) px-3 py-2 text-sm focus:border-(--color-brand-primary) focus:outline-none"
              />
            </div>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label for="company" class="text-sm font-semibold">Company</label>
              <input
                id="company"
                name="company"
                type="text"
                class="mt-1 w-full rounded-md border border-(--color-brand-border) px-3 py-2 text-sm focus:border-(--color-brand-primary) focus:outline-none"
              />
            </div>
            <div>
              <label for="interest" class="text-sm font-semibold">What you're after</label>
              <select
                id="interest"
                name="interest"
                class="mt-1 w-full rounded-md border border-(--color-brand-border) bg-white px-3 py-2 text-sm focus:border-(--color-brand-primary) focus:outline-none"
              >
                <option value="">Select one</option>
                <option value="website">New website</option>
                <option value="integrations">CRM / e-commerce / system integration</option>
                <option value="seo">SEO + organic growth</option>
                <option value="ads">Paid ads + tracking</option>
                <option value="cdp">CDP / first-party data</option>
                <option value="other">Something else</option>
              </select>
            </div>
          </div>
          <div>
            <label for="message" class="text-sm font-semibold">Project Details</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="What does your business do? What's not working in your current stack? What outcome are you actually trying to hit?"
              class="mt-1 w-full rounded-md border border-(--color-brand-border) px-3 py-2 text-sm focus:border-(--color-brand-primary) focus:outline-none"
            ></textarea>
          </div>
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="absolute -left-[9999px]"
            aria-hidden="true"
          />
          <button
            type="submit"
            class="rounded-md bg-(--color-brand-primary) px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-(--color-brand-primary-dark)"
          >
            Send Message
          </button>
        </form>
        <p class="mt-3 text-xs text-(--color-brand-ink-muted)">
          We'll never share your information.
        </p>
      </div>
    </div>
  </section>
</Layout>
